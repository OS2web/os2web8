{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8",
            "exclude": ["drupal/anonymous_subscriptions"]
        },
        {
            "type": "vcs",
            "url": "https://github.com/bellcom/anonymous_subscriptions"
        },
	    {
            "type": "vcs",
            "url": "https://github.com/bellcom/fds_base_theme"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bellcom/borgerdk-php"
        },
	{
		"type": "vcs",
		"url": "https://github.com/bellcom/access_latest"
	}
    ],
    "require": {
        "bellcom/fds_base_theme": "dev-drupal10",
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/access_latest": "dev-main",
        "drupal/action": "^0.2",
        "drupal/admin_audit_trail": "^1.0",
        "drupal/admin_toolbar": "^3.5",
        "drupal/anonymous_subscriptions": "dev-drupal11",
        "drupal/autologout": "^1.4",
        "drupal/better_exposed_filters": "^7.0",
        "drupal/checklistapi": "^2.1",
        "drupal/chosen": "^4.0",
        "drupal/ckeditor_iframe": "^3.0@alpha",
        "drupal/classy": "^2.0",
        "drupal/color": "^2.0@alpha",
        "drupal/config_delete": "^2.0",
        "drupal/content_access": "^2.1@RC",
        "drupal/content_moderation_notifications": "^3.6",
        "drupal/cookieinformation": "^2.2",
        "drupal/core-composer-scaffold": "11.4.5",
        "drupal/core-project-message": "11.4.5",
        "drupal/core-recommended": "11.4.5",
        "drupal/crop": "^2.4",
        "drupal/css_editor": "^2.0",
        "drupal/csv_importer": "^2.2",
        "drupal/custom_add_content": "^2.1",
        "drupal/date_popup": "^2.0",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/editor_advanced_link": "^2.3",
        "drupal/embed": "^1.9",
        "drupal/entity_browser": "^2.11",
        "drupal/entity_clone": "^2.1@beta",
        "drupal/entity_reference_revisions": "^1.12",
        "drupal/facets": "^2.0",
        "drupal/fakeobjects": "^1.2",
        "drupal/fancy_file_delete": "^2.0",
        "drupal/feeds": "^3.0@RC",
        "drupal/feeds_ex": "^1.0@beta",
        "drupal/feeds_tamper": "dev-2.x",
        "drupal/field_group": "^3.6",
        "drupal/field_permissions": "^1.5",
        "drupal/file_delete": "^3.0",
        "drupal/flood_control": "^3.0",
        "drupal/form_options_attributes": "^2.0",
        "drupal/gdpr": "^3.1",
        "drupal/gdpr_dump": "^3.0",
        "drupal/image_effects": "^4.0",
        "drupal/image_widget_crop": "^3.0",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/link_field_autocomplete_filter": "^2.0",
        "drupal/linkit": "^7.0",
        "drupal/linkit_media_library": "^2.0",
        "drupal/matomo": "^1.25",
        "drupal/matomo_reports": "^1.6",
        "drupal/media_directories": "^2.1@beta",
        "drupal/memcache": "^2.6",
        "drupal/memcache_admin": "^2.5",
        "drupal/menu_block": "^1.13",
        "drupal/menu_breadcrumb": "^2.0@alpha",
        "drupal/menu_link_attributes": "^1.5",
        "drupal/metatag": "^2.0",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_skip_on_404": "^1.1",
        "drupal/migrate_tools": "^6.0",
        "drupal/monolog": "^3.0",
        "drupal/node_export": "^1.1",
        "drupal/node_revision_delete": "2.0.x-dev@dev",
        "drupal/paragraphs": "^1.17",
        "drupal/pathauto": "^1.13",
        "drupal/pathologic": "^2.0@alpha",
        "drupal/photoswipe": "^5.0",
        "drupal/queue_mail": "^1.6",
        "drupal/queue_ui": "^3.1",
        "drupal/quick_node_clone": "^1.22",
        "drupal/quickedit": "^2.0",
        "drupal/quicktabs": "^4.0",
        "drupal/redirect": "^1.10",
        "drupal/rules": "4.0.x-dev@dev",
        "drupal/save_edit": "^1.8",
        "drupal/scheduler": "^2.1",
        "drupal/scheduler_content_moderation_integration": "^3.0",
        "drupal/scroll_top_button": "^2.0",
        "drupal/search_api": "^1.34",
        "drupal/search_api_attachments": "^10.0",
        "drupal/search_api_autocomplete": "^1.8",
        "drupal/search_api_solr": "^4.3",
        "drupal/search_api_spellcheck": "^4.0",
        "drupal/search_api_synonym": "^3.0@beta",
        "drupal/silktide": "^11.2",
        "drupal/simplesamlphp_auth": "^4.1",
        "drupal/smtp": "^1.4",
        "drupal/stage_file_proxy": "3.0.x-dev@dev",
        "drupal/symfony_mailer_lite": "^2.0",
        "drupal/tamper": "^1.0@alpha",
        "drupal/token": "^1.15",
        "drupal/typed_data": "^2.1",
        "drupal/user_display_name": "^1.1",
        "drupal/video": "^3.0",
        "drupal/views_bulk_operations": "^4.2",
        "drupal/views_local_tasks": "^1.0",
        "drupal/webform": "^6.3@beta",
        "drupal/workbench": "^1.4",
        "drupal/workbench_access": "^2.0",
        "drupal/workbench_moderation": "^1.7",
        "drupal/xmlsitemap": "^2.0",
        "drush/drush": "^13",
        "os2core/os2core": "dev-drupal11",
        "os2web/os2web": "dev-drupal11",
        "os2web/os2web_borgerdk": "dev-master",
        "os2web/os2web_citizen_proposals": "dev-master",
        "os2web/os2web_contact": "dev-drupal10",
        "os2web/os2web_embedded_code": "dev-drupal10",
        "os2web/os2web_events": "dev-drupal10",
        "os2web/os2web_hearings": "dev-drupal10",
        "os2web/os2web_hjemmeside": "dev-drupal10",
        "os2web/os2web_kle": "dev-drupal10",
        "os2web/os2web_logging": "dev-master",
        "os2web/os2web_meetings": "dev-drupal10",
        "os2web/os2web_meetings_acadre": "dev-master",
        "os2web/os2web_meetings_agman": "dev-master",
        "os2web/os2web_meetings_edoc": "dev-master",
        "os2web/os2web_meetings_edoc_fujitsu": "dev-drupal10",
        "os2web/os2web_news": "dev-drupal10",
        "os2web/os2web_newsletter": "dev-master",
        "os2web/os2web_pagebuilder": "dev-drupal10",
        "os2web/os2web_person_information": "dev-drupal10",
        "os2web/os2web_postlister": "dev-master",
        "os2web/os2web_search": "dev-drupal10",
        "os2web/os2web_spotbox": "dev-drupal10"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "simplesamlphp/composer-module-installer": true,
            "simplesamlphp/composer-xmlprovider-installer": true,
            "symfony/runtime": true,
            "wikimedia/composer-merge-plugin": true,
            "zaporylie/composer-drupal-optimizations": true
        },
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-7qs6-zvnz-h66r": "Reviewed; allow update to fixed guzzlehttp/psr7"
                }
            }
        }
    },
    "extra": {
        "patches": {
            "drupal/core": {
                "fix views pager offset": "https://www.drupal.org/files/issues/2024-03-06/mr-4707-vs-10.2.x.patch"
            },
            "drupal/search_api_synonym": {
                "3542593 - Fix dependency on Drupal Console, pages crash when there's no Drupal Console in the project\n": "https://git.drupalcode.org/project/search_api_synonym/-/merge_requests/32.diff"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
