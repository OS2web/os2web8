{#
/**
 * @file
 * Paragraph template for the "Hero" paragraph type.
 *
 * Available variables:
 * - paragraph: The paragraph entity.
 * - content: A list of all fields attached to this paragraph.
 *   e.g. content.field_background_image, content.field_links, content.field_heading, content.field_subheading
 *
 * Note: If you want a raw value (e.g., from a text field), you could use:
 *   paragraph.field_heading.value
 * However, using {{ content.field_heading }} generally respects text format settings, etc.
 * Adjust as appropriate for your use case.
 */
#}

{# Retrieve image URL (assuming "field_background_image" is the field name). #}
{% set background_image_url = '' %}
{% if content.field_background_image.0['#item'] is defined %}
  {% set background_image_url = file_url(content.field_background_image.0['#item'].entity.uri.value) %}
{% endif %}

<div
  class="paragraph paragraph--type--hero"
  {% if background_image_url %}
    style="background-image: url('{{ background_image_url }}');"
  {% endif %}
>
  <div class="hero-overlay"><!-- optional overlay if needed --></div>

  <div class="hero-content-wrapper">
    {# Heading Field #}
    {% if content.field_hero_heading is not empty %}
      <h2 class="hero-heading">{{ content.field_hero_heading }}</h2>
    {% endif %}

    {# Subheading Field #}
    {% if content.field_hero_subheading is not empty %}
      <div class="hero-subheading">{{ content.field_hero_subheading }}</div>
    {% endif %}

    {# Links Field (up to a maximum of 8) #}
    {% if content.field_hero_links is not empty %}
      <div class="hero-links-wrapper">
        <ul class="hero-links-list">

          {# Loop through each referenced "Hero Link" paragraph #}
          {% for hero_link_paragraph in content.field_referenced_hero_links %}
            {# The child paragraph’s fields are accessible as well #}

            {# Extract link data. Typically:
               hero_link_paragraph.field_link.0['#url'] => \Drupal\Core\Url
               hero_link_paragraph.field_link.0['#title'] => link text
            #}
            {% set link_url_obj = hero_link_paragraph.field_hero_link.0['#url'] ?? null %}
            {% set link_text = hero_link_paragraph.field_hero_link.0['#title'] ?? '' %}

            {# Extract boolean for highlight:
               Depending on how the boolean field is rendered, you might find:
               hero_link_paragraph.field_highlight.0['#markup'] = '1' (or 0)
               or hero_link_paragraph.field_highlight['#items'].value
            #}
            {% set highlight_value = hero_link_paragraph.field_highlight.0['#markup'] ?? '' %}
            {% set is_highlighted = (highlight_value == '1') ? true : false %}

            {% if link_url_obj %}
              {% set link_url = link_url_obj.toString %}

              {# Conditionally add a class if highlighted #}
              <li class="{{ is_highlighted ? 'is-highlighted' : '' }}">
                <a href="{{ link_url }}">{{ link_text }}</a>
              </li>
            {% endif %}

          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
</div>
