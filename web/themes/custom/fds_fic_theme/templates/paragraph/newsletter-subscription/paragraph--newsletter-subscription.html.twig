{#
/**
 * @file
 * Newsletter subscription paragraph template.
 *
 * Available variables:
 * - content: All paragraph fields. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the paragraph wrapper.
 * - paragraph: Full paragraph entity.
 *   Only id, revision_id, and bundle fields are available.
 * - content_attributes: HTML attributes for the paragraph content wrapper.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'newsletter-subscription',
  ]
%}

<div{{ attributes.addClass(classes) }}>
  <div class="newsletter-subscription__container">
    {% if content.field_newsletter_title %}
      <h2 class="newsletter-subscription__title">{{ content.field_newsletter_title }}</h2>
    {% endif %}

    <div class="newsletter-content-wrapper">
      {% if content.field_newsletter_description %}
        <div class="newsletter-subscription__description">
          {{ content.field_newsletter_description }}
        </div>
      {% endif %}

      <form class="nyhedsbrev-form" action="https://fredericia.uxmail.io/handlers/post/" method="post">
        <input type="hidden" name="action" value="subscribe">
        <input type="hidden" name="lists" value="85204">
        <input type="hidden" name="success_url" value="/succes-nyhedsbrev">
        <input type="hidden" name="failure_url" value="/fejl-nyhedsbrev">
        <input type="hidden" name="optin_scheme" value="double">

        <div class="newsletter-subscription__form-wrapper">
          <div class="newsletter-subscription__input">
            <label for="email_address_id" class="visually-hidden">E-mail adresse</label>
            <input type="text" name="email_address" id="email_address_id" placeholder="Din e-mail">
          </div>

          <div class="newsletter-subscription__submit">
            <input type="submit" value="Tilmeld nyhedsbrev">
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
