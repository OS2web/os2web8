{% set image_position_class = 'image-left' %}
{% if paragraph.hasField('field_fifty_fifty_layout') and content.field_fifty_fifty_layout[0]['#markup'] is defined %}
  {% set image_position_class = content.field_fifty_fifty_layout[0]['#markup'] == 'Billede højre/Tekst venstre' ? 'image-right' : 'image-left' %}
{% endif %}

{% set text_position_class = 'text-align-left' %}
{% if paragraph.hasField('field_fifty_fifty_text_layout') and content.field_fifty_fifty_text_layout[0]['#markup'] is defined %}
  {% set text_position_class = content.field_fifty_fifty_text_layout[0]['#markup'] == 'Center tekst alignment' ? 'text-align-center' : 'text-align-left' %}
{% endif %}

{% set selectedColor = '' %}
{% if paragraph.hasField('field_fifty_fifty_bg_color') and not paragraph.field_fifty_fifty_bg_color.isEmpty %}
  {% set selectedColor = paragraph.field_fifty_fifty_bg_color.value %}
{% endif %}

{% set remove_bottom_margin = paragraph.hasField('field_remove_bottom_margin') ? paragraph.field_remove_bottom_margin.value : false %}
{% set margin_class = remove_bottom_margin ? 'no-bottom-margin' : '' %}

{% set color_map = {
  'bg_blue': '#00b6d7',
  'bg_lightblue': '#aabfcf',
  'bg_red': '#ff4000',
  'bg_lightred': '#f3e7e7',
  'bg_green': '#3e8346',
  'bg_lightgreen': '#dce6d9',
  'bg_black': '#000',
  'bg_lightblack': '#222222',
  'bg_greyblue': '#8fa8b8',
  'bg_greygreen': '#a8b8a2',
  'bg_lightorange': '#d8c9b6',
  'bg_bluegreen': '#dceae6',
  'bg_warmgrey': '#f3f4f4',
} %}

{% set text_color_map = {
  'bg_blue': 'text-side-white',
  'bg_lightblue': 'text-side-black',
  'bg_red': 'text-side-white',
  'bg_lightred': 'text-side-black',
  'bg_green': 'text-side-white',
  'bg_lightgreen': 'text-side-black',
  'bg_black': 'text-side-white',
  'bg_lightblack': 'text-side-gray',
  'bg_greyblue': 'text-side-black',
  'bg_greygreen': 'text-side-black',
  'bg_lightorange': 'text-side-black',
  'bg_bluegreen': 'text-side-black',
  'bg_warmgrey': 'text-side-black',
} %}

{% set background_color = color_map[selectedColor]|default('#ffffff') %}
{% set text_color_class = text_color_map[selectedColor]|default('text-side-black') %}

<div class="paragraph-50-50-wrapper paragraph--type--aabningstider {{ image_position_class }} {{ margin_class }}">
  {% if paragraph.hasField('field_fifty_fifty_image') and paragraph.field_fifty_fifty_image is not empty %}
    <div class="image-side">
      {{ content.field_fifty_fifty_image }}
    </div>
  {% elseif paragraph.hasField('field_fifty_fifty_video') and paragraph.field_fifty_fifty_video is not empty %}
    <div class="image-side">
      {% if paragraph.hasField('field_fifty_fifty_video_poster') and paragraph.field_fifty_fifty_video_poster is not empty %}
        {% set poster_file = paragraph.field_fifty_fifty_video_poster.entity %}
        {% if poster_file %}
          {% set poster_url = file_url(poster_file.uri.value) %}
          <div class="video-with-poster">
            {{ content.field_fifty_fifty_video }}
            <div class="video-poster" style="background-image: url('{{ poster_url }}');">
              <div class="play-button">
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="30" cy="30" r="30" fill="rgba(0,0,0,0.7)"/>
                  <path d="M25 20L25 40L40 30L25 20Z" fill="white"/>
                </svg>
              </div>
            </div>
          </div>
        {% else %}
          {{ content.field_fifty_fifty_video }}
        {% endif %}
      {% else %}
        {{ content.field_fifty_fifty_video }}
      {% endif %}
    </div>
  {% elseif paragraph.hasField('field_fifty_fifty_iframe') and paragraph.field_fifty_fifty_iframe is not empty %}
    <div class="image-side">
      {{ content.field_fifty_fifty_iframe }}
    </div>
  {% endif %}

  <div style="background-color: {{ background_color }};" class="text-side {{ text_position_class }} {{ text_color_class }}">
    {% if paragraph.hasField('field_fifty_fifty_heading') and content.field_fifty_fifty_heading %}
      <h2 class="fifty-fifty-heading">{{ content.field_fifty_fifty_heading }}</h2>
    {% endif %}

    <div class="paragraph-50-50-description aabningstider-hours">
      {{ content.field_aabningstider }}
    </div>
  </div>
</div>
