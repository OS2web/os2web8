{%
  set classes = [
  'element-wrapper-link',
  node.bundle|clean_class,
  node.isPromoted() ? 'is-promoted',
  node.isSticky() ? 'is-sticky',
  not node.isPublished() ? 'is-unpublished',
  view_mode ? view_mode|clean_class,
]
%}
{% set pageTeaserText = content.field_event_resume is empty
  ? content.body|render
  : content.field_event_resume|render %}

<a href="{{ path('entity.node.canonical', {'node': node.id}) }}" class="news-teaser" aria-label="{{ 'Read more about'|trans }} {{ label|striptags|trim }}">
  <i class="fa-solid fa-arrow-right"></i>
  <div class="news-teaser-body">
    <h3 class="event-title">{{ label|striptags|trim }}</h3>
    <div class="news-teaser-text">
      {{ pageTeaserText|striptags|trim }}
    </div>
    <div class="my-breadcrumbs">
      <div class="breadcrumb-item">
        {{ 'Begivenheder'|trans }}
      </div>
    </div>
  </div>
</a>

