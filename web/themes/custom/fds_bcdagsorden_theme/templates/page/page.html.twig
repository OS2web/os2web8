<header class="d-print-none">
  <div class="custom-header">
    <div class="custom-header-row custom-header-row--meta">
      <div class="container">
        <div class="flexy-row">

          <a href="{{ url('<front>') }}" class="custom-header__logo">
              {% if custom_logo %}
                <img src="{{ custom_logo }}" alt="Logo" />
              {% else %}
                <img src="{{ base_path ~ directory }}/dist/images/logo.png" alt="Logo" />
              {% endif %}

          </a>

          <div class="flexy-spacer"></div>

          <div class="d-none d-md-block">
            {{ page.header__top_navigation }}
          </div>
        </div>
      </div>
    </div>
    <div class="custom-header-row custom-header-row--desktop-navigation d-none d-md-block">
      <div class="container">
        <div class="flexy-row">
          <div class="flexy-spacer"></div>

          {{ page.header__main_navigation }}
        </div>
      </div>
    </div>
    <div class="custom-header-row custom-header-row--mobile-navigation d-md-none">
      <div class="container">
        <div class="flexy-row">
          <div class="flexy-spacer"></div>

          <div class="custom-mobile-navigation">
            <div class="custom-mobile-navigation__overlay"></div>

            <button class="custom-mobile-navigation-toggle js-custom-mobile-navigation-toggle">
              <span class="icon fa fa-bars"></span>
              <span class="icon fa fa-times"></span>
            </button>

            <div class="custom-mobile-navigation-popup">
              <div class="custom-mobile-navigation-popup__navigation custom-mobile-navigation-popup__navigation--vertical">
                {{ page.header__main_navigation }}
              </div>
              <div class="custom-mobile-navigation-popup__navigation custom-mobile-navigation-popup__navigation--horizontal">
                {{ page.header__top_navigation }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

{{ page.alert }}
{{ page.banner_search }}
{{ page.featured_top }}

  <div class="section section--breadcrumb-bar d-print-none layout--hidden-on-sections">
    <div class="container">
      <div class="flexy-row">
        {{ page.breadcrumb }}

        <div class="flexy-spacer"></div>

        {% include '@fds_bcdagsorden_theme/includes/action-buttons.html.twig' %}
        {{ page.small_search }}
      </div>
    </div>
  </div>


<div class="page-container" id="font-resize-wrapper">
  <div class="container">
    {{ page.highlighted }}

    <div id="main-content" class="row layout--hidden-on-sections">
      {%
        set content_classes = [
        page.sidebar_second ? 'col-12 col-md-9',
        page.sidebar_second is empty ? 'col-12',
      ]
      %}

      {% if page.sidebar_first %}
        {% block sidebar_first %}
          <aside class="col-12 col-md-3">
            <div class="layout-sidebar-left">
              {{ page.sidebar_first }}
            </div>
          </aside>
        {% endblock %}
      {% endif %}

      <main {{ content_attributes.addClass(content_classes) }}>
        <div class="layout-content">
          {{ page.content }}
        </div>
      </main>

      <aside class="col-12 col-md-3 d-print-none">
        <div class="layout-sidebar-right">
          {% if page.sidebar_second %}
            {% block sidebar_second %}

              {{ page.sidebar_second }}
            {% endblock %}
          {% endif %}
        </div>
      </aside>
    </div>
  </div>

  {{ page.featured_bottom_first }}
  <a href="/abonner" class="abonner-banner">
    <div class="abonner-banner-item container">
      <div><svg xmlns="http://www.w3.org/2000/svg" class="ionicon" viewBox="0 0 512 512"><path d="M427.68 351.43C402 320 383.87 304 383.87 217.35 383.87 138 343.35 109.73 310 96c-4.43-1.82-8.6-6-9.95-10.55C294.2 65.54 277.8 48 256 48s-38.21 17.55-44 37.47c-1.35 4.6-5.52 8.71-9.95 10.53-33.39 13.75-73.87 41.92-73.87 121.35C128.13 304 110 320 84.32 351.43 73.68 364.45 83 384 101.61 384h308.88c18.51 0 27.77-19.61 17.19-32.57zM320 384v16a64 64 0 01-128 0v-16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/></svg></div>
      <div>Abonner på indhold fra {{ theme_settings.contact_information.business_owner_name }}</div>
    </div>
  </a>
</div>

{% include '@fds_bcdagsorden_theme/includes/footer.html.twig' %}
