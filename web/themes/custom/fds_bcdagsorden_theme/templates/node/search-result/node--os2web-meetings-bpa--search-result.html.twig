{%
  set classes = [
  'element-wrapper-link',
  node.bundle|clean_class,
  node.isPromoted() ? 'is-promoted',
  node.isSticky() ? 'is-sticky',
  not node.isPublished() ? 'is-unpublished',
  view_mode ? view_mode|clean_class,
]
%}
<a href="{{ url }}" {{ attributes.addClass(classes) }}>
  <div class="search-meeting-heading">
    <span>Bilag</span>
    <h3>{{ label }}</h3>
  </div>

  <div class="row meetings-row">
    <div class="col-12 search-meeting__type-link-wrapper">
      <div class="field--type-link">
        {{ 'Read more' | trans }}
      </div>
    </div>
  </div>
</a>
