{%
  set classes = [
  node.bundle|clean_class,
  node.isPromoted() ? 'is-promoted',
  node.isSticky() ? 'is-sticky',
  not node.isPublished() ? 'is-unpublished',
  view_mode ? view_mode|clean_class,
]
%}
{% set timestamp = node.field_os2web_m_start_date.date|date('U') %}
<div {{ attributes.addClass(classes) }}>

  <h1>{{ node.field_os2web_m_type.value }} for {{ label }}</h1>

  <div class="meetings-udvalg">
    <p class="udvalg-heading">Udvalg</p>
    {% for item in node.field_os2web_m_committee %}
    {% set term = item.entity %}
    <p class="udvalg-term">{{ term.label() }}</p>
    {% endfor %}
  </div>

  <div class="meetings-date">
    <p class="date-heading">Mødedato</p>
    {% if timestamp %}
      <p class="date-time">{{ timestamp | format_date('os2core_datetime_medium') }}</p>
    {% endif %}
  </div>

  <div class="meetings-lokation">
    <p class="lokation-heading">Mødested</p>
    {{ content.field_os2web_m_location }}
  </div>

  {# ✅ Only show participants sections if type is "Referat" #}
  {% if node.field_os2web_m_type.value == "Referat" %}
    <div class="meetings-participants">
      <p class="participants-heading">Tilstede</p>
      {{ content.field_os2web_m_partic }}
    </div>

    <div class="meetings-participants-cancel">
      <p class="participants-heading">Fraværende</p>
      {{ content.field_os2web_m_partic_cancel }}
    </div>
  {% endif %}


  {{ content.body }}

  {% if (content.field_os2web_m_bps['open']) or (content.field_os2web_m_bps['closed']) %}
    {% if (content.field_os2web_m_bps['open']) %}
      <br>
      <h2> Åben dagsorden </h2>
      {{ content.field_os2web_m_bps['open'] }}
    {% endif %}
    {% if (content.field_os2web_m_bps['closed']) %}
      <h2> Lukket dagsorden </h2>
      {{ content.field_os2web_m_bps['closed'] }}
    {% endif %}

  {% else %}
    {{ content.field_os2web_m_bps }}
  {% endif %}
</div>
