<div class="action-buttons d-none d-md-block">
  <div class="flexy-list">
    <div>
      <a href="#" class="action-button" title="Slå adgang med tegn til/fra" onclick="SignLanguageMark(null, '#ff2345');">
        <span class="icon fa fa-sign-language"></span>
      </a>
    </div>

    {% set link = theme_settings.adgangforalle %}

    <div>
      <a href="{{ link }}" class="action-button" {% if link starts with 'http' and not (link contains current_host) %} target="_blank" rel="noopener noreferrer" {% endif %}>
        <span class="icon fa fa-volume-up"></span>
      </a>
    </div>

    <div>
      <a href="#" class="action-button" onclick="window.print();">
        <span class="icon fa fa-print"></span>
      </a>
    </div>
  </div>
</div>
