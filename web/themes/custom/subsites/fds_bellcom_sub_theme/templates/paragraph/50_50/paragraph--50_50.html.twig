
{% set image_position_class = content.field_fifty_fifty_layout[0]['#markup'] == 'Billede højre/Tekst venstre' ? 'image-right' : 'image-left' %}
{% set text_position_class = content.field_fifty_fifty_text_layout[0]['#markup'] == 'Center tekst alignment' ? 'text-align-center' : 'text-align-left' %}
{# Brug altid maskinnavnet direkte fra feltet i stedet for render-arrayet, og fald tilbage til tom streng hvis feltet er tomt #}
{% set selectedColor = paragraph.field_fifty_fifty_bg_color.value|default('') %}
{% set selectedButtonColor = paragraph.field_fifty_fifty_btn_color.value|default('') %}
{% set selectedBulletColor = paragraph.field_bullet_color.value %}

{% set color_map = {
  'bg_white': '#ffffff',
  'bg_grey': '#454545',
  'bg_black': '#231f20'
} %}

{% set text_color_map = {
  'bg_white': 'text-side-black',
  'bg_grey': 'text-side-white',
  'bg_black': 'text-side-white'
} %}

{% set button_color_classes = {
  'btn_white': 'button-white',
  'btn_grey': 'button-grey',
  'btn_black': 'button-black'
} %}

{% set background_color = color_map[selectedColor]|default('#ffffff') %}
{% set text_color_class = text_color_map[selectedColor]|default('text-side-black') %}
{% set button_class = button_color_classes[selectedButtonColor]|default('button-white') %}



<div class="paragraph-50-50-wrapper {{ image_position_class }}">
  {% if paragraph.field_fifty_fifty_image is not empty %}
    <div class="image-side">
      {{ content.field_fifty_fifty_image }}
    </div>
  {% endif %}
  {% if paragraph.field_fifty_fifty_video is not empty and paragraph.field_fifty_fifty_image is empty %}
    <div class="image-side">
      {{ content.field_fifty_fifty_video }}
    </div>
  {% endif %}
  {% if paragraph.field_fifty_fifty_iframe is not empty and paragraph.field_fifty_fifty_image is empty and paragraph.field_fifty_fifty_video is empty %}
    <div class="image-side">
      {{ content.field_fifty_fifty_iframe }}
    </div>
  {% endif %}
  <div style="background-color: {{ background_color }};" class="text-side {{ text_position_class }} {{ text_color_class }}">
    <h2>{{ paragraph.field_fifty_fifty_heading.value }}</h2>
    <div class="paragraph-50-50-description {{ selectedBulletColor }}">
      {{ content.field_fifty_fifty_desc }}
    </div>
    {% if content.field_fifty_fifty_link %}
      <div class="cta-buttons {{ text_position_class }} {{ button_class }}">
        {{ content.field_fifty_fifty_link }}
      </div>
    {% endif %}
  </div>
</div>
