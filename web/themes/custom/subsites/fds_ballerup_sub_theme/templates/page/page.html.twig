
<header class="d-print-none">
  <div class="custom-header">
    <div class="custom-header-row custom-header-row--meta">
      <div class="container">
        <div class="flexy-row">

          <a href="{{ url('<front>') }}" class="custom-header__logo">
            {% if custom_logo %}
              <img src="{{ custom_logo }}" alt="{{ custom_logo_alt|default(site_name) }}" />
            {% else %}
              <img src="{{ base_path ~ directory }}/dist/images/logo.png" alt="{{ custom_logo_alt|default(site_name) }}" />
            {% endif %}
          </a>

          <div class="flexy-spacer"></div>

          <div class="d-none d-md-block">
            {{ page.header__top_navigation }}
          </div>
        </div>
      </div>
    </div>
    <div class="custom-header-row custom-header-row--desktop-navigation d-none d-md-block">
      <div class="container">
        <div class="flexy-row">
          <div class="flexy-spacer"></div>
          {{ page.header__main_navigation }}
        </div>
      </div>
    </div>
    <div class="custom-header-row custom-header-row--mobile-navigation d-md-none">
      <div class="container">
        <div class="flexy-row">
          <div class="flexy-spacer"></div>
          <div class="custom-mobile-navigation">
            <div class="custom-mobile-navigation__overlay"></div>

            <button 
              class="custom-mobile-navigation-toggle js-custom-mobile-navigation-toggle"
              aria-label="Menu"
              aria-expanded="false"
              aria-controls="custom-mobile-navigation-popup">
              <span class="icon fa fa-bars" aria-hidden="true"></span>
              <span class="icon fa fa-times" aria-hidden="true"></span>
              <span class="visually-hidden">Åbn menu</span>
            </button>

            <div class="custom-mobile-navigation-popup" id="custom-mobile-navigation-popup" aria-label="Navigation" role="dialog" aria-modal="true" aria-hidden="true">
              <div class="custom-mobile-navigation-popup__header">
                <h2 class="custom-mobile-navigation-popup__title">Menu</h2>
                <button 
                  class="custom-mobile-navigation-popup__close js-custom-mobile-navigation-toggle"
                  aria-label="Luk menu">
                  <span class="fa fa-times" aria-hidden="true"></span>
                  <span class="visually-hidden">Luk menu</span>
                </button>
              </div>
              
              <div class="custom-mobile-navigation-popup__content">
                <div class="custom-mobile-navigation-popup__navigation custom-mobile-navigation-popup__navigation--vertical">
                  {% for key, item in page.header__main_navigation %}
                    {% if key|first != '#' and key != 'system_branding_block' and key != 'site_branding_block' %}
                      {{ item }}
                    {% endif %}
                  {% endfor %}
                </div>
                <div class="custom-mobile-navigation-popup__navigation custom-mobile-navigation-popup__navigation--horizontal">
                  {% for key, item in page.header__top_navigation %}
                    {% if key|first != '#' and key != 'system_branding_block' and key != 'site_branding_block' %}
                      {{ item }}
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

{{ page.alert }}
{{ page.banner_search }}

<div class="section section--breadcrumb-bar d-print-none layout--hidden-on-sections">
  <div class="container">
    <div class="flexy-row">
      {{ page.breadcrumb }}
      <div class="flexy-spacer"></div>
      {% include '@fds_ballerup_sub_theme/includes/action-buttons.html.twig' %}
      {{ page.small_search }}
    </div>
  </div>
</div>

{{ page.featured_top }}

<div class="page-container" id="font-resize-wrapper">
  <div class="container">
    {{ page.highlighted }}

    <div class="row layout--hidden-on-sections">
      {% if ((path('<current>') starts with '/brug-byen/kunst-i-ballerup') ) or ((path('<current>') starts with '/alle-kunstvaerker/')) %}
        {%
          set content_classes = ['col-12 col-md-8']
        %}
      {% else %}
        {%
          set content_classes = [
            page.sidebar_first ? 'col-12 col-md-6',
            page.sidebar_first is empty ? 'col-12 col-md-8',
          ]
        %}
      {% endif %}
      {% if page.sidebar_first %}
        {% block sidebar_first %}
          <aside class="col-12 col-md-4">
            <div class="layout-sidebar-left">
              {{ page.sidebar_first }}
            </div>
          </aside>
        {% endblock %}
      {% endif %}

      <main {{ content_attributes.addClass(content_classes) }}>
        <div class="layout-content">
          {{ page.content }}
        </div>
      </main>

      {% if ( not (path('<current>') starts with '/brug-byen/kunst-i-ballerup')) and ( not (path('<current>') starts with '/alle-kunstvaerker/')) %}
        <aside class="col-12 col-md-4 d-print-none">
          <div class="layout-sidebar-right">
            {% if page.sidebar_second %}
              {% block sidebar_second %}
                {{ page.sidebar_second }}
              {% endblock %}
            {% endif %}
          </div>
        </aside>
      {% endif %}
    </div>
  </div>

  {{ page.featured_bottom_first }}
</div>

{% include '@fds_ballerup_sub_theme/includes/footer.html.twig' %}
