{% set classes = [
  'banner',
  'paragraph',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished'
] %}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }} {% if background_image %} style="background-image: url({{ background_image }})" {% endif %}>
    
    {# Status Banner - Full width at top #}
    {% if paragraph.field_os2web_banner_status_text.value and paragraph.field_os2web_banner_status_color.value %}
      {% set status_color = paragraph.field_os2web_banner_status_color.value %}
      {% set status_border_color = '' %}
      {% set status_bg_color = '' %}
      {% set status_text_color = '' %}
      
      {% if status_color == 'red' or status_color == 'Rød' or status_color == 'alert' %}
        {% set status_border_color = '#DC3545' %}
        {% set status_bg_color = '#FFF5F5' %}
        {% set status_text_color = '#721C24' %}
      {% elseif status_color == 'yellow' or status_color == 'Gul' or status_color == 'warning' %}
        {% set status_border_color = '#FFC107' %}
        {% set status_bg_color = '#FFFBF0' %}
        {% set status_text_color = '#856404' %}
      {% elseif status_color == 'green' or status_color == 'Grøn' or status_color == 'alright' %}
        {% set status_border_color = '#28A745' %}
        {% set status_bg_color = '#F0F9F4' %}
        {% set status_text_color = '#155724' %}
      {% endif %}
      
      <div class="banner__status" style="border-top: 3px solid {{ status_border_color }}; border-bottom: 3px solid {{ status_border_color }}; background-color: {{ status_bg_color }}; color: {{ status_text_color }};">
        <div class="container">
          <div class="banner__status-content">
            {{ content.field_os2web_banner_status_text }}
          </div>
        </div>
      </div>
    {% endif %}
    
    <div class="container">
      {% block content %}
      {% if paragraph.field_os2web_banner_heading.value or 
      paragraph.field_os2web_banner_subheading.value or 
      paragraph.field_os2web_banner_body.value or 
      paragraph.field_os2web_banner_links.value %}
        <div class="banner__box">

          {% if paragraph.field_os2web_banner_heading.value %}
            <div class="banner__heading">
              {{ content.field_os2web_banner_heading }}
            </div>
          {% endif %}

          {% if paragraph.field_os2web_banner_subheading.value or paragraph.field_os2web_banner_body.value %}
            <div class="banner__body">
              {{ content.field_os2web_banner_subheading }}
              {{ content.field_os2web_banner_body }}
            </div>
          {% endif %}

          {% if paragraph.field_os2web_banner_links.value %}
            <div class="banner__actions">
              {{ content.field_os2web_banner_links }}
            </div>
          {% endif %}

        </div>
      {% endif %}
      {% endblock %}
    </div>
  </div>
{% endblock paragraph %}
