{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}

    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('sidenav-list') }} data-level="{{ menu_level }}">
    {% else %}
      <ul class="sidenav-sub_list" data-level="{{ menu_level }}">
    {% endif %}

    {% for item in items %}
      {%
        set classes = [
          item.in_active_trail ? 'current',
          item.is_active ? 'active',
          (item.is_expanded and item.below) ? 'has-submenu',
        ]
      %}

      <li{{ item.attributes.addClass(classes) }} data-level="{{ menu_level }}" data-has-children="{{ item.below ? 'true' : 'false' }}">
        {% if menu_level == 0 %}
          {{ link(item.title, item.url, {'class': 'main-link', 'data-level': menu_level}) }}
        {% else %}
          <a href="{{ item.url }}" class="sub-link-a sub-link-level-{{ menu_level }}" data-level="{{ menu_level }}">
            {{ item.title }}
          </a>
        {% endif %}


        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>

    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}