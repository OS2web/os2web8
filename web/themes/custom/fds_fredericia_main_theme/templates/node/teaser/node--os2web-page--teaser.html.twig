{%
  set classes = [
  'element-wrapper-link',
  node.bundle|clean_class,
  node.isPromoted() ? 'is-promoted',
  node.isSticky() ? 'is-sticky',
  not node.isPublished() ? 'is-unpublished',
  view_mode ? view_mode|clean_class,
]
%}
{# Title: heading -> meta title -> node title #}
{% set headingRendered = content.field_os2web_page_heading|render %}
{% set headingText = headingRendered|striptags|trim %}
{% set teaserTitleText = headingText is not empty ? headingText : (meta_title ? meta_title : node.label) %}

{# Description: intro -> description -> meta description (as plain text) #}
{% set introRendered = content.field_os2web_page_intro|render %}
{% set introText = introRendered|striptags|trim|replace({'&#13;': ''}) %}

{% set descriptionRendered = content.field_os2web_page_description|render %}
{% set descriptionText = descriptionRendered|striptags|trim|replace({'&#13;': ''}) %}

{% set pageTeaserText = introText is not empty
  ? introText
  : (descriptionText is not empty ? descriptionText : (meta_description ? meta_description : ''))
%}





<a href="{{ url }}" class="page-teaser" aria-label="{{ 'Read more about' | trans }} {{ teaserTitleText }}">
  <i class="fa-solid fa-arrow-right"></i>
  <div class="page-teaser-body">
    {% if headingRendered|trim is not empty %}
      {{ headingRendered }}
    {% else %}
      {{ teaserTitleText }}
    {% endif %}

    {% if pageTeaserText is not empty %}
      <div class="page-teaser-text">
        {{ pageTeaserText }}
      </div>
    {% endif %}
    {% if menu_hierarchy %}
      <div class="my-breadcrumbs">
        {% for item in menu_hierarchy %}
          <div class="breadcrumb-item">{{ item }}</div>
          {% if not loop.last %} {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</a>
