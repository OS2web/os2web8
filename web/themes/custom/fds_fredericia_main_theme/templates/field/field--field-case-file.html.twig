{#
/**
 * @file
 * Default theme implementation to display a file field.
 */
#}
<!-- Debug: Field name: {{ element['#field_name'] }} -->
<!-- Debug: Bundle: {{ element['#bundle'] }} -->
<!-- Debug: Entity type: {{ element['#entity_type'] }} -->

{% for item in items %}
  <!-- Debug: Item content type: {{ item.content['#type'] }} -->
  <div{{ attributes.addClass('field__item') }}>
    <span class="file file--mime-application-pdf file--application-pdf">
      {{ item.content }}
    </span>
  </div>
{% endfor %} 